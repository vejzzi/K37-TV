rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidId(id) {
      return id.matches('^[a-zA-Z0-9_\\-]+$') && id.size() > 0 && id.size() <= 128;
    }

    match /schedules/{dayId} {
      allow read: if true;
      allow write: if isValidId(dayId) && 
        request.resource.data.dayId is string &&
        request.resource.data.programs is list &&
        request.resource.data.programs.size() <= 100;
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if isValidId(newsId) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 500 &&
        request.resource.data.summary is string &&
        request.resource.data.summary.size() <= 3000;
    }

    match /settings/ticker {
      allow read: if true;
      allow write: if request.resource.data.headlines is list &&
        request.resource.data.headlines.size() <= 100;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
